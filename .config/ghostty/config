# This configuration is for use with tmux
# (the least worst way to get session persistence for remote multiplexing)

# See https://github.com/0xhckr/ghostty-shaders
#
# custom-shader = ./shaders/retro-terminal.glsl
# custom-shader = ./shaders/glitchy.glsl
# custom-shader = ./shaders/bettercrt.glsl

keybind=clear

window-height     = 1280
window-width      = 1280
window-decoration = false
gtk-titlebar      = false

gtk-tabs-location = top

foreground     = 000000
background     = ffffff
bold-is-bright = false
# true makes gray color white, useless

font-size      = 14
font-variation = wght=400

keybind = alt+backspace=text:\x17
keybind = f11=toggle_fullscreen
keybind = alt+f5=reload_config
keybind = alt+shift+p=toggle_command_palette
keybind = alt+c=copy_to_clipboard
keybind = alt+v=paste_from_clipboard
keybind = alt+minus=decrease_font_size:1
keybind = alt+equal=increase_font_size:1
keybind = alt+shift+n=new_window
keybind = ctrl+alt+t=new_tab

keybind = ctrl+alt+1=goto_tab:1
keybind = ctrl+alt+2=goto_tab:2
keybind = ctrl+alt+3=goto_tab:3
keybind = ctrl+alt+4=goto_tab:4
keybind = ctrl+alt+5=goto_tab:5
keybind = ctrl+alt+6=goto_tab:6
keybind = ctrl+alt+7=goto_tab:7
keybind = ctrl+alt+8=goto_tab:8
keybind = ctrl+alt+9=goto_tab:9

shell-integration-features = ssh-env,ssh-terminfo
